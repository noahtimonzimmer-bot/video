[
 {
  "start": 1.2,
  "end": 3.361,
  "text": "You're standing on the roof of a forty-story building."
 },
 {
  "start": 3.501,
  "end": 5.108,
  "text": "Your girlfriend is hanging from the edge."
 },
 {
  "start": 5.248,
  "end": 6.336,
  "text": "You're holding her hand."
 },
 {
  "start": 6.476,
  "end": 8.064,
  "text": "And your shadow is holding a knife."
 },
 {
  "start": 8.204,
  "end": 9.711,
  "text": "But here's the terrifying part."
 },
 {
  "start": 9.851,
  "end": 11.604,
  "text": "Your shadow isn't pointing the knife at her."
 },
 {
  "start": 11.744,
  "end": 12.83,
  "text": "It's pointing it at YOU."
 },
 {
  "start": 12.97,
  "end": 13.637,
  "text": "You scream."
 },
 {
  "start": 13.777,
  "end": 15.28,
  "text": "And your shadow raises its arm."
 },
 {
  "start": 15.42,
  "end": 16.343,
  "text": "THREE DAYS EARLIER."
 },
 {
  "start": 17.193,
  "end": 18.452,
  "text": "You wake up late for work."
 },
 {
  "start": 18.592,
  "end": 19.623,
  "text": "You brush your teeth."
 },
 {
  "start": 19.763,
  "end": 20.687,
  "text": "Put on your shoes."
 },
 {
  "start": 20.827,
  "end": 21.767,
  "text": "And walk outside."
 },
 {
  "start": 21.907,
  "end": 23.014,
  "text": "Everything seems normal."
 },
 {
  "start": 23.154,
  "end": 24.758,
  "text": "Until you notice something strange."
 },
 {
  "start": 24.898,
  "end": 25.986,
  "text": "Your shadow is waving."
 },
 {
  "start": 26.126,
  "end": 26.916,
  "text": "But you're not."
 },
 {
  "start": 27.056,
  "end": 27.936,
  "text": "You stop walking."
 },
 {
  "start": 28.076,
  "end": 28.865,
  "text": "It stops too."
 },
 {
  "start": 29.005,
  "end": 30.221,
  "text": "You raise your right hand."
 },
 {
  "start": 30.361,
  "end": 31.863,
  "text": "Your shadow raises its left."
 },
 {
  "start": 32.003,
  "end": 32.668,
  "text": "You laugh."
 },
 {
  "start": 32.808,
  "end": 34.025,
  "text": "Maybe you're just tired."
 },
 {
  "start": 34.165,
  "end": 35.186,
  "text": "Then you turn around."
 },
 {
  "start": 35.326,
  "end": 36.83,
  "text": "And your shadow stays where it is."
 },
 {
  "start": 36.97,
  "end": 37.85,
  "text": "You stare at it."
 },
 {
  "start": 37.99,
  "end": 38.907,
  "text": "It stares back."
 },
 {
  "start": 39.047,
  "end": 39.535,
  "text": "Well..."
 },
 {
  "start": 40.135,
  "end": 41.057,
  "text": "It doesn't have eyes."
 },
 {
  "start": 41.197,
  "end": 42.843,
  "text": "But somehow, you know it's watching you."
 },
 {
  "start": 42.983,
  "end": 44.37,
  "text": "You take one step backward."
 },
 {
  "start": 44.51,
  "end": 46.282,
  "text": "Your shadow takes one step forward."
 },
 {
  "start": 46.422,
  "end": 46.911,
  "text": "You run."
 },
 {
  "start": 47.051,
  "end": 47.776,
  "text": "It follows."
 },
 {
  "start": 47.916,
  "end": 49.304,
  "text": "But not the way a shadow should."
 },
 {
  "start": 49.444,
  "end": 50.459,
  "text": "It runs beside you."
 },
 {
  "start": 51.059,
  "end": 52.446,
  "text": "You rush into your apartment."
 },
 {
  "start": 52.586,
  "end": 53.255,
  "text": "Lock the door."
 },
 {
  "start": 53.395,
  "end": 54.608,
  "text": "And turn off every light."
 },
 {
  "start": 54.748,
  "end": 55.93,
  "text": "Your shadow disappears."
 },
 {
  "start": 56.07,
  "end": 57.158,
  "text": "You finally relax."
 },
 {
  "start": 57.298,
  "end": 58.514,
  "text": "Then your phone lights up."
 },
 {
  "start": 58.654,
  "end": 60.259,
  "text": "And your shadow appears on the wall."
 },
 {
  "start": 60.399,
  "end": 61.125,
  "text": "Except now..."
 },
 {
  "start": 61.725,
  "end": 62.392,
  "text": "It's knocking."
 },
 {
  "start": 62.532,
  "end": 63.323,
  "text": "Three times."
 },
 {
  "start": 63.463,
  "end": 64.55,
  "text": "You turn off your phone."
 },
 {
  "start": 64.69,
  "end": 65.36,
  "text": "Silence."
 },
 {
  "start": 65.5,
  "end": 67.253,
  "text": "Then you hear three knocks on your front door."
 },
 {
  "start": 67.393,
  "end": 68.609,
  "text": "You look through the peephole."
 },
 {
  "start": 68.749,
  "end": 69.63,
  "text": "Nobody's there."
 },
 {
  "start": 69.77,
  "end": 71.679,
  "text": "But something has been scratched into the wood."
 },
 {
  "start": 71.819,
  "end": 72.743,
  "text": "DON'T GO TO WORK."
 },
 {
  "start": 73.593,
  "end": 75.234,
  "text": "You think someone's playing a prank."
 },
 {
  "start": 75.374,
  "end": 76.297,
  "text": "So you ignore it."
 },
 {
  "start": 76.437,
  "end": 78.597,
  "text": "Twenty minutes later, you arrive at your office."
 },
 {
  "start": 78.737,
  "end": 79.998,
  "text": "You step into the elevator."
 },
 {
  "start": 80.138,
  "end": 81.586,
  "text": "Your shadow stays outside."
 },
 {
  "start": 81.726,
  "end": 83.17,
  "text": "It grabs the elevator doors."
 },
 {
  "start": 83.31,
  "end": 84.898,
  "text": "And refuses to let them close."
 },
 {
  "start": 85.038,
  "end": 86.22,
  "text": "You pull your foot back."
 },
 {
  "start": 86.36,
  "end": 87.091,
  "text": "The doors shut."
 },
 {
  "start": 87.231,
  "end": 88.262,
  "text": "The elevator rises."
 },
 {
  "start": 88.402,
  "end": 88.728,
  "text": "Then..."
 },
 {
  "start": 89.328,
  "end": 90.34,
  "text": "A deafening crash."
 },
 {
  "start": 90.48,
  "end": 91.588,
  "text": "The elevator falls."
 },
 {
  "start": 91.728,
  "end": 92.837,
  "text": "Straight to the basement."
 },
 {
  "start": 92.977,
  "end": 94.085,
  "text": "You would have been inside."
 },
 {
  "start": 94.225,
  "end": 95.834,
  "text": "Your shadow just saved your life."
 },
 {
  "start": 96.684,
  "end": 98.19,
  "text": "That night, you decide to test it."
 },
 {
  "start": 98.33,
  "end": 99.589,
  "text": "You put a lamp on the floor."
 },
 {
  "start": 99.729,
  "end": 101.18,
  "text": "Your shadow appears on the wall."
 },
 {
  "start": 101.32,
  "end": 101.942,
  "text": "You ask:"
 },
 {
  "start": 102.542,
  "end": 103.652,
  "text": "\"Can you understand me?\""
 },
 {
  "start": 103.792,
  "end": 104.413,
  "text": "It nods."
 },
 {
  "start": 104.553,
  "end": 105.178,
  "text": "You freeze."
 },
 {
  "start": 105.318,
  "end": 106.427,
  "text": "\"Can you see the future?\""
 },
 {
  "start": 106.567,
  "end": 107.355,
  "text": "It nods again."
 },
 {
  "start": 107.495,
  "end": 108.712,
  "text": "You grab a piece of paper."
 },
 {
  "start": 108.852,
  "end": 109.613,
  "text": "\"Write something.\""
 },
 {
  "start": 109.753,
  "end": 111.399,
  "text": "Your shadow points toward the kitchen."
 },
 {
  "start": 111.539,
  "end": 112.328,
  "text": "You follow it."
 },
 {
  "start": 112.468,
  "end": 115.346,
  "text": "On the refrigerator is a photograph of you and your girlfriend, Emma."
 },
 {
  "start": 115.486,
  "end": 116.745,
  "text": "Your shadow points at Emma."
 },
 {
  "start": 116.885,
  "end": 119.038,
  "text": "Then slowly draws a line across its own throat."
 },
 {
  "start": 119.178,
  "end": 120.266,
  "text": "You stumble backward."
 },
 {
  "start": 120.406,
  "end": 120.707,
  "text": "\"No.\""
 },
 {
  "start": 120.847,
  "end": 122.362,
  "text": "Your shadow points at the clock."
 },
 {
  "start": 122.502,
  "end": 123.759,
  "text": "Eleven fifty-nine P.M."
 },
 {
  "start": 123.899,
  "end": 124.568,
  "text": "You call Emma."
 },
 {
  "start": 124.708,
  "end": 125.334,
  "text": "No answer."
 },
 {
  "start": 125.474,
  "end": 126.263,
  "text": "You call again."
 },
 {
  "start": 126.403,
  "end": 127.135,
  "text": "Still nothing."
 },
 {
  "start": 127.275,
  "end": 128.726,
  "text": "Then you receive a message from her."
 },
 {
  "start": 128.866,
  "end": 130.622,
  "text": "\"Someone is standing outside my window.\""
 },
 {
  "start": 130.762,
  "end": 131.777,
  "text": "You grab your keys."
 },
 {
  "start": 131.917,
  "end": 132.403,
  "text": "And run."
 },
 {
  "start": 133.003,
  "end": 134.262,
  "text": "You reach Emma's apartment."
 },
 {
  "start": 134.402,
  "end": 135.249,
  "text": "Her door is open."
 },
 {
  "start": 135.389,
  "end": 136.313,
  "text": "The lights are flickering."
 },
 {
  "start": 136.453,
  "end": 136.755,
  "text": "\"Emma?\""
 },
 {
  "start": 136.895,
  "end": 137.52,
  "text": "No answer."
 },
 {
  "start": 137.66,
  "end": 138.624,
  "text": "You enter the bedroom."
 },
 {
  "start": 138.764,
  "end": 140.275,
  "text": "And find her hiding beneath the bed."
 },
 {
  "start": 140.415,
  "end": 141.177,
  "text": "She's shaking."
 },
 {
  "start": 141.317,
  "end": 142.197,
  "text": "You help her up."
 },
 {
  "start": 142.337,
  "end": 143.068,
  "text": "\"What happened?\""
 },
 {
  "start": 143.208,
  "end": 144.509,
  "text": "She points toward the wall."
 },
 {
  "start": 144.649,
  "end": 145.949,
  "text": "There's a shadow standing there."
 },
 {
  "start": 146.089,
  "end": 147.194,
  "text": "A human-shaped shadow."
 },
 {
  "start": 147.334,
  "end": 148.722,
  "text": "But nobody is casting it."
 },
 {
  "start": 148.862,
  "end": 150.469,
  "text": "Your own shadow moves in front of you."
 },
 {
  "start": 150.609,
  "end": 151.783,
  "text": "Like it's protecting you."
 },
 {
  "start": 151.923,
  "end": 153.374,
  "text": "The other shadow tilts its head."
 },
 {
  "start": 153.514,
  "end": 154.395,
  "text": "Then smiles."
 },
 {
  "start": 154.535,
  "end": 155.382,
  "text": "Not with a mouth."
 },
 {
  "start": 155.522,
  "end": 157.337,
  "text": "With a thin white crack across its face."
 },
 {
  "start": 157.477,
  "end": 158.865,
  "text": "Your shadow grabs your arm."
 },
 {
  "start": 159.005,
  "end": 160.261,
  "text": "And pulls you toward the door."
 },
 {
  "start": 160.401,
  "end": 160.89,
  "text": "You run."
 },
 {
  "start": 161.03,
  "end": 163.762,
  "text": "Behind you, the other shadow begins crawling across the ceiling."
 },
 {
  "start": 163.902,
  "end": 164.932,
  "text": "You reach the stairs."
 },
 {
  "start": 165.072,
  "end": 167.032,
  "text": "And suddenly every light in the building goes out."
 },
 {
  "start": 167.172,
  "end": 168.259,
  "text": "The creature disappears."
 },
 {
  "start": 168.399,
  "end": 169.615,
  "text": "But so does your shadow."
 },
 {
  "start": 169.755,
  "end": 170.861,
  "text": "And for the first time..."
 },
 {
  "start": 171.461,
  "end": 172.569,
  "text": "You realize you need it."
 },
 {
  "start": 173.419,
  "end": 175.011,
  "text": "You and Emma escape into the street."
 },
 {
  "start": 175.151,
  "end": 177.111,
  "text": "Under the streetlights, your shadow returns."
 },
 {
  "start": 177.251,
  "end": 178.192,
  "text": "It looks exhausted."
 },
 {
  "start": 178.332,
  "end": 179.249,
  "text": "Almost smaller."
 },
 {
  "start": 179.389,
  "end": 180.777,
  "text": "You ask it what that thing was."
 },
 {
  "start": 180.917,
  "end": 182.456,
  "text": "Your shadow points at the ground."
 },
 {
  "start": 182.596,
  "end": 183.221,
  "text": "Then at Emma."
 },
 {
  "start": 183.361,
  "end": 183.983,
  "text": "Then at you."
 },
 {
  "start": 184.123,
  "end": 185.211,
  "text": "You don't understand."
 },
 {
  "start": 185.351,
  "end": 186.647,
  "text": "So Emma takes out her phone."
 },
 {
  "start": 186.787,
  "end": 188.379,
  "text": "She opens an old photograph."
 },
 {
  "start": 188.519,
  "end": 190.271,
  "text": "It's a picture of you from five years ago."
 },
 {
  "start": 190.411,
  "end": 191.593,
  "text": "You're standing beside her."
 },
 {
  "start": 191.733,
  "end": 192.307,
  "text": "Smiling."
 },
 {
  "start": 192.447,
  "end": 193.555,
  "text": "But there's something wrong."
 },
 {
  "start": 193.695,
  "end": 195.198,
  "text": "Your shadow is facing the camera."
 },
 {
  "start": 195.338,
  "end": 196.595,
  "text": "Even though you're facing away."
 },
 {
  "start": 196.735,
  "end": 197.305,
  "text": "You zoom in."
 },
 {
  "start": 197.445,
  "end": 198.898,
  "text": "Your shadow is holding something."
 },
 {
  "start": 199.038,
  "end": 199.979,
  "text": "A small black key."
 },
 {
  "start": 200.119,
  "end": 200.882,
  "text": "Emma whispers:"
 },
 {
  "start": 201.482,
  "end": 202.404,
  "text": "\"I remember that day.\""
 },
 {
  "start": 202.544,
  "end": 203.213,
  "text": "You look at her."
 },
 {
  "start": 203.353,
  "end": 204.084,
  "text": "\"What happened?\""
 },
 {
  "start": 204.224,
  "end": 205.015,
  "text": "She swallows."
 },
 {
  "start": 205.155,
  "end": 206.176,
  "text": "\"You were in an accident.\""
 },
 {
  "start": 206.316,
  "end": 207.241,
  "text": "You laugh nervously."
 },
 {
  "start": 207.381,
  "end": 208.171,
  "text": "\"What accident?\""
 },
 {
  "start": 208.311,
  "end": 209.494,
  "text": "Her eyes fill with tears."
 },
 {
  "start": 209.634,
  "end": 210.205,
  "text": "\"You died.\""
 },
 {
  "start": 211.055,
  "end": 212.809,
  "text": "Five years ago, you were hit by a car."
 },
 {
  "start": 212.949,
  "end": 214.452,
  "text": "Your heart stopped for four minutes."
 },
 {
  "start": 214.592,
  "end": 215.774,
  "text": "Doctors brought you back."
 },
 {
  "start": 215.914,
  "end": 218.303,
  "text": "But Emma tells you something she never mentioned before."
 },
 {
  "start": 218.443,
  "end": 220.75,
  "text": "When you woke up, you kept saying the same sentence."
 },
 {
  "start": 220.89,
  "end": 222.15,
  "text": "\"Something followed me back.\""
 },
 {
  "start": 222.29,
  "end": 223.586,
  "text": "You don't remember any of it."
 },
 {
  "start": 223.726,
  "end": 225.334,
  "text": "Your shadow suddenly begins moving."
 },
 {
  "start": 225.474,
  "end": 226.689,
  "text": "It points at your chest."
 },
 {
  "start": 226.829,
  "end": 227.751,
  "text": "Then at the ground."
 },
 {
  "start": 227.891,
  "end": 229.343,
  "text": "Then it lies perfectly still."
 },
 {
  "start": 229.483,
  "end": 230.363,
  "text": "You understand."
 },
 {
  "start": 230.503,
  "end": 231.796,
  "text": "It isn't predicting your death."
 },
 {
  "start": 231.936,
  "end": 232.859,
  "text": "It's remembering it."
 },
 {
  "start": 232.999,
  "end": 233.622,
  "text": "You ask:"
 },
 {
  "start": 234.222,
  "end": 235.482,
  "text": "\"Are you the thing that followed me?\""
 },
 {
  "start": 235.622,
  "end": 236.9,
  "text": "Your shadow shakes its head."
 },
 {
  "start": 237.04,
  "end": 238.222,
  "text": "Then points behind Emma."
 },
 {
  "start": 238.362,
  "end": 238.852,
  "text": "You turn."
 },
 {
  "start": 238.992,
  "end": 240.949,
  "text": "Under the streetlight, Emma has two shadows."
 },
 {
  "start": 241.089,
  "end": 241.936,
  "text": "One moves with her."
 },
 {
  "start": 242.076,
  "end": 242.855,
  "text": "The other doesn't."
 },
 {
  "start": 242.995,
  "end": 244.748,
  "text": "The second shadow slowly stands up."
 },
 {
  "start": 244.888,
  "end": 245.68,
  "text": "Emma screams."
 },
 {
  "start": 245.82,
  "end": 246.74,
  "text": "And both of you run."
 },
 {
  "start": 247.34,
  "end": 248.599,
  "text": "You race through the streets."
 },
 {
  "start": 248.739,
  "end": 250.333,
  "text": "But now you notice them everywhere."
 },
 {
  "start": 250.473,
  "end": 252.434,
  "text": "A man waiting for a bus has three shadows."
 },
 {
  "start": 252.574,
  "end": 253.958,
  "text": "A woman walking her dog has none."
 },
 {
  "start": 254.098,
  "end": 257.058,
  "text": "A child standing beneath a streetlight has a shadow twice his size."
 },
 {
  "start": 257.198,
  "end": 258.971,
  "text": "Something is happening to the entire city."
 },
 {
  "start": 259.111,
  "end": 261.263,
  "text": "Your shadow pulls you toward an abandoned building."
 },
 {
  "start": 261.403,
  "end": 262.66,
  "text": "Inside is a staircase."
 },
 {
  "start": 262.8,
  "end": 263.464,
  "text": "You climb."
 },
 {
  "start": 263.604,
  "end": 264.613,
  "text": "Floor after floor."
 },
 {
  "start": 264.753,
  "end": 265.86,
  "text": "Until you reach the roof."
 },
 {
  "start": 266.0,
  "end": 267.757,
  "text": "Your shadow points toward the horizon."
 },
 {
  "start": 267.897,
  "end": 268.743,
  "text": "The sun is setting."
 },
 {
  "start": 268.883,
  "end": 270.844,
  "text": "And every shadow in the city is getting longer."
 },
 {
  "start": 270.984,
  "end": 271.712,
  "text": "Emma asks:"
 },
 {
  "start": 272.312,
  "end": 273.492,
  "text": "\"Why did it bring us here?\""
 },
 {
  "start": 273.632,
  "end": 274.894,
  "text": "Then you notice the black key."
 },
 {
  "start": 275.034,
  "end": 276.141,
  "text": "It's lying on the roof."
 },
 {
  "start": 276.281,
  "end": 278.366,
  "text": "Exactly like the one in the old photograph."
 },
 {
  "start": 278.506,
  "end": 279.958,
  "text": "Beside it is a locked metal door."
 },
 {
  "start": 280.098,
  "end": 280.767,
  "text": "You open it."
 },
 {
  "start": 280.907,
  "end": 282.122,
  "text": "Inside is a single mirror."
 },
 {
  "start": 282.262,
  "end": 283.761,
  "text": "And written above it are five words:"
 },
 {
  "start": 284.361,
  "end": 285.683,
  "text": "ONLY ONE OF YOU BELONGS HERE."
 },
 {
  "start": 286.533,
  "end": 287.549,
  "text": "You look into the mirror."
 },
 {
  "start": 287.689,
  "end": 288.719,
  "text": "You see yourself."
 },
 {
  "start": 288.859,
  "end": 289.161,
  "text": "Emma."
 },
 {
  "start": 289.301,
  "end": 290.144,
  "text": "And your shadow."
 },
 {
  "start": 290.284,
  "end": 292.616,
  "text": "But in the reflection, your shadow is standing upright."
 },
 {
  "start": 292.756,
  "end": 293.687,
  "text": "Like a real person."
 },
 {
  "start": 293.827,
  "end": 294.842,
  "text": "It steps forward."
 },
 {
  "start": 294.982,
  "end": 295.707,
  "text": "And speaks."
 },
 {
  "start": 295.847,
  "end": 297.896,
  "text": "\"You were never supposed to survive that accident.\""
 },
 {
  "start": 298.036,
  "end": 299.124,
  "text": "You stumble backward."
 },
 {
  "start": 299.264,
  "end": 300.48,
  "text": "Your shadow continues."
 },
 {
  "start": 300.62,
  "end": 303.289,
  "text": "\"When your heart stopped, something tried to take your place.\""
 },
 {
  "start": 303.429,
  "end": 304.16,
  "text": "You look at Emma."
 },
 {
  "start": 304.3,
  "end": 306.226,
  "text": "Her second shadow is crawling up the wall."
 },
 {
  "start": 306.366,
  "end": 307.625,
  "text": "Your shadow points at it."
 },
 {
  "start": 307.765,
  "end": 309.377,
  "text": "\"That thing has been waiting five years.\""
 },
 {
  "start": 309.517,
  "end": 310.141,
  "text": "You whisper:"
 },
 {
  "start": 310.741,
  "end": 311.111,
  "text": "\"Why?\""
 },
 {
  "start": 311.251,
  "end": 313.558,
  "text": "\"Because it cannot enter the living world without a body.\""
 },
 {
  "start": 313.698,
  "end": 314.808,
  "text": "Emma grabs your hand."
 },
 {
  "start": 314.948,
  "end": 317.248,
  "text": "Then her second shadow suddenly pulls her backward."
 },
 {
  "start": 317.388,
  "end": 318.896,
  "text": "Straight toward the edge of the roof."
 },
 {
  "start": 319.036,
  "end": 319.959,
  "text": "You catch her wrist."
 },
 {
  "start": 320.099,
  "end": 321.282,
  "text": "She slips over the side."
 },
 {
  "start": 321.422,
  "end": 321.908,
  "text": "And now..."
 },
 {
  "start": 322.508,
  "end": 324.669,
  "text": "You're standing on the roof of a forty-story building."
 },
 {
  "start": 324.809,
  "end": 326.416,
  "text": "Your girlfriend is hanging from the edge."
 },
 {
  "start": 326.556,
  "end": 327.644,
  "text": "You're holding her hand."
 },
 {
  "start": 327.784,
  "end": 329.372,
  "text": "And your shadow is holding a knife."
 },
 {
  "start": 329.972,
  "end": 331.267,
  "text": "Your shadow raises the knife."
 },
 {
  "start": 331.407,
  "end": 332.073,
  "text": "You scream:"
 },
 {
  "start": 332.673,
  "end": 333.245,
  "text": "\"STOP!\""
 },
 {
  "start": 333.385,
  "end": 334.473,
  "text": "But it doesn't stop."
 },
 {
  "start": 334.613,
  "end": 335.72,
  "text": "It brings the blade down."
 },
 {
  "start": 335.86,
  "end": 337.119,
  "text": "Straight toward your hand."
 },
 {
  "start": 337.259,
  "end": 338.28,
  "text": "You close your eyes."
 },
 {
  "start": 338.42,
  "end": 339.527,
  "text": "And hear a sharp crack."
 },
 {
  "start": 339.667,
  "end": 340.394,
  "text": "You open them."
 },
 {
  "start": 340.534,
  "end": 341.978,
  "text": "Your shadow hasn't stabbed you."
 },
 {
  "start": 342.118,
  "end": 344.447,
  "text": "It has cut through the black shape wrapped around your wrist."
 },
 {
  "start": 344.587,
  "end": 345.51,
  "text": "The second shadow."
 },
 {
  "start": 345.65,
  "end": 347.421,
  "text": "It was using Emma to pull you over the edge."
 },
 {
  "start": 347.561,
  "end": 348.592,
  "text": "The creature screams."
 },
 {
  "start": 348.732,
  "end": 349.841,
  "text": "Your shadow grabs it."
 },
 {
  "start": 349.981,
  "end": 351.365,
  "text": "And drags it toward the mirror."
 },
 {
  "start": 351.505,
  "end": 352.764,
  "text": "The mirror begins to crack."
 },
 {
  "start": 352.904,
  "end": 354.163,
  "text": "You pull Emma onto the roof."
 },
 {
  "start": 354.303,
  "end": 356.119,
  "text": "The two shadows disappear into the glass."
 },
 {
  "start": 356.259,
  "end": 357.345,
  "text": "Then the mirror shatters."
 },
 {
  "start": 357.485,
  "end": 358.155,
  "text": "Silence."
 },
 {
  "start": 358.295,
  "end": 359.022,
  "text": "You look down."
 },
 {
  "start": 359.162,
  "end": 360.193,
  "text": "Your shadow is gone."
 },
 {
  "start": 360.333,
  "end": 361.84,
  "text": "For the first time in your life..."
 },
 {
  "start": 362.44,
  "end": 363.383,
  "text": "You don't cast one."
 },
 {
  "start": 364.233,
  "end": 365.157,
  "text": "Three weeks pass."
 },
 {
  "start": 365.297,
  "end": 366.909,
  "text": "You and Emma move to a new apartment."
 },
 {
  "start": 367.049,
  "end": 368.371,
  "text": "Everything feels normal again."
 },
 {
  "start": 368.511,
  "end": 369.769,
  "text": "One morning, you wake up."
 },
 {
  "start": 369.909,
  "end": 371.171,
  "text": "Sunlight fills the bedroom."
 },
 {
  "start": 371.311,
  "end": 372.235,
  "text": "You look at the floor."
 },
 {
  "start": 372.375,
  "end": 373.462,
  "text": "Your shadow is back."
 },
 {
  "start": 373.602,
  "end": 374.271,
  "text": "You smile."
 },
 {
  "start": 374.411,
  "end": 375.142,
  "text": "\"You're alive.\""
 },
 {
  "start": 375.282,
  "end": 375.905,
  "text": "It waves."
 },
 {
  "start": 376.045,
  "end": 376.834,
  "text": "You wave back."
 },
 {
  "start": 376.974,
  "end": 378.19,
  "text": "Then Emma walks into the room."
 },
 {
  "start": 378.33,
  "end": 379.121,
  "text": "She kisses you."
 },
 {
  "start": 379.261,
  "end": 380.202,
  "text": "And leaves for work."
 },
 {
  "start": 380.342,
  "end": 381.186,
  "text": "You watch her go."
 },
 {
  "start": 381.326,
  "end": 382.973,
  "text": "Your shadow slowly turns toward you."
 },
 {
  "start": 383.113,
  "end": 384.564,
  "text": "Then points at the bedroom mirror."
 },
 {
  "start": 384.704,
  "end": 385.275,
  "text": "You look."
 },
 {
  "start": 385.415,
  "end": 387.612,
  "text": "In the reflection, Emma is still standing behind you."
 },
 {
  "start": 387.752,
  "end": 388.325,
  "text": "Smiling."
 },
 {
  "start": 388.465,
  "end": 389.723,
  "text": "Even though she just left."
 },
 {
  "start": 389.863,
  "end": 390.742,
  "text": "You turn around."
 },
 {
  "start": 390.882,
  "end": 391.763,
  "text": "Nobody's there."
 },
 {
  "start": 391.903,
  "end": 393.163,
  "text": "Then the reflection whispers:"
 },
 {
  "start": 393.763,
  "end": 394.795,
  "text": "\"You saved the wrong one.\""
 }
]